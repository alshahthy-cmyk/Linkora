{
  "expo": {
    "name": "Linkora",
    "slug": "mobile",
    "owner": "alshahthyameer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0C17"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.alshahthyameer.linkora",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@config-plugins/react-native-webrtc",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Linkora to access your photos to share images.",
          "cameraPermission": "Allow Linkora to access your camera to capture photos and videos."
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Linkora to access your microphone to record voice messages and make calls."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "601926ee-67ef-4158-8a3f-f3333dc1a298"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
